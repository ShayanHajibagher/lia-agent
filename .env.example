# ---------- مدل زبانی ----------
# روی هاست، localhost یعنی خودِ کانتینر؛ پس LM Studio محلی از اینجا در دسترس نیست.
# یک درگاه OpenAI-compatible بده (مثال: BoxAPI). خالی بگذاری، حالت دمو فعال می‌شود.
LIA_LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LIA_LLM_API_KEY=
LIA_LLM_MODEL=gpt-6-luna

# اگر مدل «reasoning» است و خطای پارامتر گرفتی، این‌ها را دستی ست کن:
# LIA_LLM_TOKEN_PARAM=max_completion_tokens
# LIA_LLM_TEMPERATURE=0
# LIA_LLM_REASONING_EFFORT=none

# ---------- رفتار دیپلوی ----------
# 1 = دیپلوی شبیه‌سازی (پیشنهاد برای دمو روی هاست: سریع، بدون نصب/بیلد واقعی)
# 0 = اجرای واقعی پروژهٔ کاربر روی همین کانتینر (نیاز به منابع و ایزوله‌سازی)
LIA_DEPLOY_SIMULATE=1

# ---------- ذخیره‌سازی ----------
# پیش‌فرض: ./.data کنار برنامه (روی لیارا موقت است و با هر دیپلوی پاک می‌شود)
# برای ماندگاری، یک دیسک به برنامه وصل کن و مسیرش را بده:
# LIA_DATA_DIR=/data
